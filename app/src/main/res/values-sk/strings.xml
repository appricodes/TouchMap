    <string name="credits_title">Poďakovanie</string>
    <string name="credits_intro">Navia je postavená na nasledujúcich otvorených dátach a open-source projektoch.</string>
    <string name="credits_osm_body">Mapové údaje © prispievatelia OpenStreetMap, dostupné pod licenciou Open Database License (ODbL). Pozrite openstreetmap.org/copyright.</string>
    <string name="credits_geonames_body">Názvy miest zobrazené predtým, než je stiahnutá podrobná mapa, pochádzajú z geografickej databázy GeoNames, licencovanej pod Creative Commons Attribution 4.0. Pozrite geonames.org.</string>
    <string name="credits_geofabrik_body">Regionálne výrezy OpenStreetMap, z ktorých sa zostavujú stiahnuteľné mapové údaje tejto aplikácie. Pozrite geofabrik.de.</string>
    <string name="credits_msgpack_body">Binárna serializácia údajov, licencované pod licenciou Apache 2.0. Pozrite msgpack.org.</string>
    <string name="credits_androidx_heading">AndroidX a Material Components</string>
    <string name="credits_androidx_body">Základný framework aplikácií pre Android a komponenty rozhrania od Googlu, licencované pod licenciou Apache 2.0.</string>
