    <string name="menu_share">Condividi Navia</string>
    <string name="share_prompt_title">Ti piace Navia? Fallo sapere!</string>
    <string name="share_prompt_message">Vuoi condividere Navia con altre persone? Puoi inviare il link di download via e-mail, WhatsApp o qualsiasi altra app o social network, a un amico, a un familiare o a chiunque possa usare una mappa che si può toccare e ascoltare.</string>
    <string name="share_prompt_never">Non chiedermelo più</string>
    <string name="share_prompt_share">Condividi</string>
    <string name="share_prompt_not_now">Non ora</string>
    <string name="share_chooser_title">Condividi Navia</string>
    <string name="share_subject">Navia – una mappa che puoi toccare</string>
    <string name="share_text">Scopri Navia, una mappa che puoi toccare! Fai scorrere il dito sullo schermo e ascolta le strade, i negozi e i luoghi proprio sotto di esso. Completamente accessibile, pensata per persone cieche e ipovedenti e utile a tutti. Gratis su Google Play: %1$s</string>
    <string name="safety_warning_title">Avviso di sicurezza importante</string>
    <string name="safety_warning_message">Non basare mai i tuoi spostamenti su ciò che dice questa app. Per motivi tecnici – i limiti del GPS e di altri strumenti di misura, errori nei dati della mappa e difetti del software – le sue informazioni potrebbero essere sbagliate. Usa sempre metodi sicuri, come il bastone bianco o un cane guida, e considera questa app solo un aiuto in più.</string>
    <string name="safety_warning_accept">Ho capito e accetto</string>
