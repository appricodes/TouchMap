    <string name="menu_share">Comparteix Navia</string>
    <string name="share_prompt_title">T\'agrada Navia? Passa-ho!</string>
    <string name="share_prompt_message">Vols compartir Navia amb altres persones? Pots enviar l\'enllaç de descàrrega per correu electrònic, WhatsApp o qualsevol altra aplicació o xarxa social, a un amic, a un familiar o a qualsevol persona a qui li pugui servir un mapa que es pot tocar i escoltar.</string>
    <string name="share_prompt_never">No ho tornis a preguntar</string>
    <string name="share_prompt_share">Comparteix</string>
    <string name="share_prompt_not_now">Ara no</string>
    <string name="share_chooser_title">Comparteix Navia</string>
    <string name="share_subject">Navia – un mapa que pots tocar</string>
    <string name="share_text">Descobreix Navia, un mapa que pots tocar! Llisca el dit per la pantalla i escolta els carrers, les botigues i els llocs que tens just a sota. Totalment accessible i pensat per a persones cegues i amb baixa visió, i divertit per a tothom. Gratis a Google Play: %1$s</string>
    <string name="safety_warning_title">Avís de seguretat important</string>
    <string name="safety_warning_message">No basis mai els teus desplaçaments en el que diu aquesta aplicació. Per motius tècnics – els límits del GPS i d\'altres instruments de mesura, errors en les dades del mapa i errors del programari – la informació pot ser incorrecta. Utilitza sempre mètodes segurs, com el bastó blanc o el gos pigall, i considera aquesta aplicació només una ajuda addicional.</string>
    <string name="safety_warning_accept">Ho entenc i ho accepto</string>
