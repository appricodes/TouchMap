    <string name="menu_credits">Crèdits</string>
    <string name="credits_title">Crèdits</string>
    <string name="credits_intro">Navia es basa en les dades obertes i els projectes de codi obert següents.</string>
    <string name="credits_osm_body">Dades cartogràfiques © col·laboradors d\'OpenStreetMap, disponibles sota la Open Database License (ODbL). Consulta openstreetmap.org/copyright.</string>
    <string name="credits_geonames_body">Els noms de lloc que es mostren abans de baixar un mapa detallat provenen de la base de dades geogràfica GeoNames, amb llicència Creative Commons Attribution 4.0. Consulta geonames.org.</string>
    <string name="credits_geofabrik_body">Extractes regionals d\'OpenStreetMap emprats per crear les dades de mapa baixables d\'aquesta aplicació. Consulta geofabrik.de.</string>
    <string name="credits_msgpack_body">Serialització binària de dades, amb llicència Apache 2.0. Consulta msgpack.org.</string>
    <string name="credits_androidx_heading">AndroidX i Material Components</string>
    <string name="credits_androidx_body">Marc bàsic d\'aplicacions Android i components d\'interfície de Google, amb llicència Apache 2.0.</string>
    <string name="credits_play_services_heading">Serveis de Google Play — Ubicació</string>
