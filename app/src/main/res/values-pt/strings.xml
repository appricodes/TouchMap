    <string name="credits_title">Créditos</string>
    <string name="credits_intro">O Navia é construído com base nos seguintes dados abertos e projetos de código aberto.</string>
    <string name="credits_osm_body">Dados de mapa © colaboradores do OpenStreetMap, disponíveis sob a Open Database License (ODbL). Consulte openstreetmap.org/copyright.</string>
    <string name="credits_geonames_body">Os nomes de lugares exibidos antes de um mapa detalhado ser baixado vêm do banco de dados geográfico GeoNames, licenciado sob a Creative Commons Attribution 4.0. Consulte geonames.org.</string>
    <string name="credits_geofabrik_body">Extratos regionais do OpenStreetMap usados para criar os dados de mapa baixáveis deste aplicativo. Consulte geofabrik.de.</string>
    <string name="credits_msgpack_body">Serialização binária de dados, licenciada sob a Licença Apache 2.0. Consulte msgpack.org.</string>
    <string name="credits_androidx_heading">AndroidX e Material Components</string>
    <string name="credits_androidx_body">Framework básico de aplicativos Android e componentes de interface do Google, licenciados sob a Licença Apache 2.0.</string>
