    <string name="credits_intro">Navia מבוסס על מאגרי הנתונים הפתוחים ופרויקטי הקוד הפתוח הבאים.</string>
    <string name="credits_osm_body">נתוני מפה © תורמי OpenStreetMap, זמינים תחת רישיון Open Database License (ODbL). ראו openstreetmap.org/copyright.</string>
    <string name="credits_geonames_body">שמות מקומות המוצגים לפני הורדת מפה מפורטת מגיעים ממסד הנתונים הגאוגרפי GeoNames, המורשה תחת Creative Commons Attribution 4.0. ראו geonames.org.</string>
    <string name="credits_geofabrik_body">מקטעים אזוריים של OpenStreetMap המשמשים לבניית נתוני המפה הניתנים להורדה באפליקציה זו. ראו geofabrik.de.</string>
    <string name="credits_msgpack_body">סריאליזציה בינארית של נתונים, מורשה תחת רישיון Apache 2.0. ראו msgpack.org.</string>
