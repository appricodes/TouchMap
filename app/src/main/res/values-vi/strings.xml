    <string name="credits_title">Ghi công</string>
    <string name="credits_intro">Navia được xây dựng trên các dữ liệu mở và dự án nguồn mở sau.</string>
    <string name="credits_osm_body">Dữ liệu bản đồ © những người đóng góp cho OpenStreetMap, khả dụng theo giấy phép Open Database License (ODbL). Xem openstreetmap.org/copyright.</string>
    <string name="credits_geonames_body">Tên địa điểm hiển thị trước khi tải bản đồ chi tiết đến từ cơ sở dữ liệu địa lý GeoNames, được cấp phép theo Creative Commons Attribution 4.0. Xem geonames.org.</string>
    <string name="credits_geofabrik_body">Các trích xuất OpenStreetMap theo vùng dùng để tạo dữ liệu bản đồ tải xuống được của ứng dụng này. Xem geofabrik.de.</string>
    <string name="credits_msgpack_body">Tuần tự hóa dữ liệu nhị phân, được cấp phép theo Giấy phép Apache 2.0. Xem msgpack.org.</string>
    <string name="credits_androidx_heading">AndroidX và Material Components</string>
    <string name="credits_androidx_body">Khung ứng dụng Android cốt lõi và các thành phần giao diện từ Google, được cấp phép theo Giấy phép Apache 2.0.</string>
    <string name="credits_play_services_heading">Dịch vụ Google Play — Vị trí</string>
    <string name="credits_play_services_body">Dịch vụ vị trí của thiết bị, từ Google.</string>
