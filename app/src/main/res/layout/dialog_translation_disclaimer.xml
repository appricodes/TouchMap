<?xml version="1.0" encoding="utf-8"?>
<!--
    Deliberately hardcoded English text throughout, not @string references — see
    TranslationDisclaimerDialog's class doc for why. This dialog warns about AI translation, so it
    must not itself be run through that same translation pipeline.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="20dp"
    android:paddingBottom="8dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="This translation was generated using AI and may not be fully accurate."
        android:textSize="16sp" />

    <CheckBox
        android:id="@+id/dont_show_again"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Don't show this again" />

</LinearLayout>
