<?xml version="1.0" encoding="utf-8"?>
<!--
    Custom body for FilterDialog. A custom layout rather than AlertDialog's built-in
    setMultiChoiceItems, because the dialog now needs BOTH a keyword text field and the category
    checkbox list, and AlertDialog gives the list and the custom view the same slot.

    The keyword field is a VoiceInputEditText (same component as the address search and the
    add/edit-point dialogs) rather than a plain EditText, so the primary users of this app can
    dictate the keyword instead of typing it.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="8dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/filter_keyword_label"
        android:textSize="16sp"
        android:paddingBottom="4dp" />

    <com.wikiponder.touchmap.classes.ui.VoiceInputEditText
        android:id="@+id/filter_keyword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/filter_categories_label"
        android:textSize="16sp"
        android:paddingTop="12dp"
        android:paddingBottom="4dp" />

    <!-- Fixed height, not wrap_content: this dialog has three buttons whose labels are too wide to
         sit in one row, so AlertDialog stacks them vertically (~216dp). With a wrap_content list the
         eleven categories made the dialog tall enough to push the third button ("Show Favorites")
         clean off the bottom of the screen, where it was neither visible nor reachable. Note
         android:maxHeight does NOT work here — ScrollView ignores it — which is what hid the button
         in the first place. 200dp still shows ~4 categories at a time and scrolls to the rest. -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="200dp">

        <LinearLayout
            android:id="@+id/filter_category_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </ScrollView>

</LinearLayout>
