    <string name="menu_share">Kongsi Navia</string>
    <string name="share_prompt_title">Suka Navia? Ceritakan kepada orang lain!</string>
    <string name="share_prompt_message">Mahu berkongsi Navia dengan orang lain? Anda boleh menghantar pautan muat turun melalui e-mel, WhatsApp atau mana-mana aplikasi atau rangkaian sosial lain — kepada rakan, ahli keluarga atau sesiapa yang boleh menggunakan peta yang boleh disentuh dan didengar.</string>
    <string name="share_prompt_never">Jangan tanya lagi</string>
    <string name="share_prompt_share">Kongsi</string>
    <string name="share_prompt_not_now">Bukan sekarang</string>
    <string name="share_chooser_title">Kongsi Navia</string>
    <string name="share_subject">Navia – peta yang boleh anda sentuh</string>
    <string name="share_text">Temui Navia, peta yang boleh anda sentuh! Luncurkan jari di skrin dan dengar jalan, kedai dan tempat tepat di bawahnya. Boleh diakses sepenuhnya, dibina untuk orang buta dan cacat penglihatan, dan menyeronokkan untuk semua orang. Percuma di Google Play: %1$s</string>
    <string name="safety_warning_title">Amaran keselamatan penting</string>
    <string name="safety_warning_message">Jangan sekali-kali menjadikan apa yang dikatakan aplikasi ini sebagai asas pergerakan anda. Atas sebab teknikal – had GPS dan alat pengukur lain, ralat data peta dan kerosakan perisian – maklumatnya mungkin salah. Sentiasa gunakan kaedah selamat seperti tongkat putih atau anjing pemandu, dan anggap aplikasi ini sebagai bantuan tambahan sahaja.</string>
    <string name="safety_warning_accept">Saya faham dan terima</string>
